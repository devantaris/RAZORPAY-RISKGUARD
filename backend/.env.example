# Razorpay RiskGuard — Environment Template
# Copy to .env and fill in your values

PROJECT_NAME=Razorpay RiskGuard
VERSION=0.1.0
ENVIRONMENT=development

# Redis (docker-compose service name)
REDIS_URL=redis://redis:6379/0

# Postgres (docker-compose service name)
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=riskguard
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@postgres:5432/riskguard

# LLM Provider — set to 'openai', 'gemini', 'anthropic', or 'mock' (no key needed)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Threshold Hyperparameters
DEFAULT_DECLINE_THRESHOLD=0.80
DEFAULT_STEP_UP_THRESHOLD=0.30
BANDIT_EPSILON=0.10
BANDIT_SMOOTHING_ALPHA=0.30
BANDIT_MIN_SAMPLES=50
BANDIT_FLOOR_THRESHOLD=0.40
BANDIT_CEILING_THRESHOLD=0.95
